# =============================================================================
# TINYRIDE BY DODAIL — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# NOTE: Never commit production values to version control.
# Copy this file to .env or .env.local for local development.

# -----------------------------------------------------------------------------
# 1. CLIENT-SAFE CONFIGURATION (Mobile Apps & Web Frontend)
# -----------------------------------------------------------------------------
# Supabase URL & Public Anon Key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Razorpay Key ID (Public - used only for launching checkout modal)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Google Maps API Key (Restricted to iOS bundle ID / Android package / Web origin)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyPlaceholderClientKey
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyPlaceholderClientKey

# Sentry DSN (Public client crash logging)
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# App Metadata
EXPO_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Supabase Edge Functions, Next.js Server Actions, Optimizer)
# NEVER EXPOSE THESE IN CLIENT APPLICATIONS
# -----------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS - Admin actions & Webhooks only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Razorpay Server Credentials
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_hmac

# Google Maps Platform Server Key (Distance Matrix & Route Solver)
GOOGLE_MAPS_SERVER_KEY=AIzaSyPlaceholderServerKey

# Constrained LLM API Key (AI Support Assistant Edge Function)
LLM_API_KEY=your_gemini_or_openai_api_key
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Sentry Auth Token (Source maps upload)
SENTRY_AUTH_TOKEN=sntrys_placeholder_token

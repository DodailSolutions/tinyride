{
  "expo": {
    "name": "TinyRide Driver",
    "slug": "tinyride-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tinyride-driver",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1E36"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dodail.tinyride.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TinyRide Driver records GPS coordinates when child pickup and drop milestones are verified."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1E36"
      },
      "package": "com.dodail.tinyride.driver",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
